{
  "name": "puppet-sports-revival",
  "compatibility_date": "2026-07-01",
  "main": "src/index.js",
  "routes": [
    { "pattern": "puppetsports.com", "custom_domain": true },
    { "pattern": "www.puppetsports.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "account_id": "0b01374e269cd80008534b2efebe3c58",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
